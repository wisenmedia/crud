<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
    <title>My crud application </title>
</head>
<body>
    <%- include('partials/header.ejs'); -%>
    <h1>Welcome to my  Git GitHub application</h1>
    <form action="/submit" method="POST">
        <label for="firstName">First Name:</label>
        <input type="text" name="firstName" placeholder="Enter your name" required>
        <br>
        <label for="lastName">Last Name:</label>
        <input type="text" name="lastName" placeholder="Enter your last name" required>
        <button type="submit">Submit</button>   
    </form>

    <h2 id="users">Users</h2>
    <div id="user-list">
    <ul>
        <% if (users && users.length > 0) { %>
            <% users.forEach(function(user) { %>
                <li><%= user.firstname %> <%= user.lastname %></li>
                <!-- Debugging line to show the entire user object -->
                <!--<li><%= JSON.stringify(user) %></li>-->
            <% }); %>
        <% } else { %>
            <li>No users found.</li>
        <% } %>
    </ul>
    </div>
</body>
 <script>
    function handler(id) {
      document.getElementById("title" + id).setAttribute("hidden", true)
      document.getElementById("edit" + id).setAttribute("hidden", true)
      document.getElementById("done" + id).removeAttribute("hidden")
      document.getElementById("input" + id).removeAttribute("hidden")
    }
  </script>
 <%- include('partials/footer.ejs'); -%>
</html>